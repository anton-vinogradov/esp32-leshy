{
  "schema": "leshy.prerelease.suite.v1",
  "id": "device-smoke",
  "revision": 6,
  "maximum_ready_marker_ms": 2000,
  "boot_assert": {
    "target": "clean_1x_measure",
    "profile": "esp32-div-v2-n16",
    "profile_revision": "S1-2026-08-16",
    "flash_bytes": 16777216,
    "psram_found": false,
    "buzzer_safety_configured": true,
    "buzzer_inactive": true,
    "input_detected": true,
    "interactive_ready_us": {
      "$lte": 2000000
    }
  },
  "scenarios": [
    {
      "id": "home-diagnostics-back",
      "steps": [
        {
          "id": "keypad-frontend-ready",
          "query": {
            "command": "input.state",
            "schema": "leshy.input.frontend.v1",
            "kind": "state"
          },
          "assert": {
            "status": "ready",
            "task_started": true,
            "poll_period_ms": 5,
            "debounce_ms": 12,
            "button_mask": 248,
            "stable_raw": 255,
            "valid_samples": {
              "$gte": 1
            },
            "press_events": 0,
            "release_events": 0,
            "ambiguous_presses": 0,
            "presses": {
              "select": 0,
              "up": 0,
              "down": 0,
              "left": 0,
              "right": 0
            },
            "queue_capacity": 64,
            "queue_depth": 0,
            "queue_high_water": 0,
            "queue_drops": 0,
            "dispatched_press_events": 0
          }
        },
        {
          "id": "home",
          "assert": {
            "page": "home",
            "selection": 0,
            "selected_id": "diagnostics",
            "selected_enabled": true,
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "home",
            "golden": "goldens/esp32-div-v2-n16/home.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "product-admission-fails-closed",
          "query": {
            "command": "survey.product.admission",
            "schema": "leshy.survey.product_admission.v1",
            "kind": "policy_state"
          },
          "assert": {
            "status": "explicit_start_required",
            "store_status": "missing_media",
            "store_operation": "recover_catalog",
            "store_root": "/leshy/sessions/v1",
            "required_resources": 14,
            "explicit_start": false,
            "passive_only": true,
            "persistent_required": true,
            "simulated_fallback": false,
            "hardware_touched": false,
            "radio_started": false,
            "storage_mounted": false,
            "storage_written": false,
            "format_allowed": false,
            "application_connect_calls": 0,
            "application_raw_tx_calls": 0,
            "physical_no_tx_instrumented": false
          }
        },
        {
          "id": "open-diagnostics",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "diagnostics",
            "selected_id": "diagnostics",
            "runtime_owner": "diagnostics",
            "lease_mask": 1
          },
          "capture": {
            "name": "diagnostics",
            "golden": "goldens/esp32-div-v2-n16/diagnostics.rgb565.zlib",
            "mode": "masked_exact",
            "masks": [
              [0, 145, 240, 55]
            ]
          }
        },
        {
          "id": "back-home",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 0,
            "selected_id": "diagnostics",
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "home-after-back",
            "golden": "goldens/esp32-div-v2-n16/home-after-back.rgb565.zlib",
            "mode": "exact"
          }
        }
      ]
    },
    {
      "id": "survey-commit-library-export",
      "steps": [
        {
          "id": "select-survey",
          "action": "down",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 1,
            "selected_id": "survey",
            "runtime_owner": "none",
            "lease_mask": 0
          }
        },
        {
          "id": "open-survey-setup",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "survey",
            "runtime_owner": "survey",
            "lease_mask": 1,
            "survey_workflow_state": "setup",
            "survey_workflow_status": "ready",
            "survey_observations": 0,
            "survey_generation": 0,
            "survey_pipeline_status": "ready",
            "survey_received": 0,
            "survey_forwarded": 0,
            "survey_dropped": 0,
            "survey_queue_depth": 0,
            "survey_queue_high_water": 0,
            "survey_batch_trigger": "none"
          },
          "capture": {
            "name": "survey-setup",
            "golden": "goldens/esp32-div-v2-n16/survey-setup.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "start-survey",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "survey",
            "runtime_owner": "survey",
            "lease_mask": 1,
            "survey_workflow_state": "running",
            "survey_workflow_status": "appended",
            "survey_running": true,
            "survey_observations": 3,
            "survey_generation": 0,
            "survey_pipeline_status": "drained",
            "survey_received": 3,
            "survey_forwarded": 3,
            "survey_dropped": 0,
            "survey_queue_depth": 0,
            "survey_queue_high_water": 3,
            "survey_batch_trigger": "none"
          },
          "capture": {
            "name": "survey-running",
            "golden": "goldens/esp32-div-v2-n16/survey-running.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "open-survey-detail",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "survey",
            "survey_view": "detail",
            "survey_running": true,
            "survey_observations": 3
          },
          "capture": {
            "name": "survey-detail",
            "golden": "goldens/esp32-div-v2-n16/survey-detail.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "back-survey-list",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "survey",
            "survey_view": "list",
            "survey_workflow_state": "running",
            "survey_running": true
          }
        },
        {
          "id": "stop-and-commit",
          "action": "right",
          "assert": {
            "changed": true,
            "page": "survey",
            "survey_workflow_state": "result",
            "survey_workflow_status": "committed",
            "survey_running": false,
            "survey_observations": 3,
            "survey_generation": 2,
            "survey_persistent": false,
            "survey_pipeline_status": "committed",
            "survey_received": 3,
            "survey_forwarded": 3,
            "survey_dropped": 0,
            "survey_queue_depth": 0,
            "survey_queue_high_water": 3,
            "survey_batch_trigger": "stop",
            "library_entries": 1,
            "library_generation": 2,
            "library_persistent": false
          },
          "capture": {
            "name": "survey-committed",
            "golden": "goldens/esp32-div-v2-n16/survey-committed.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "stop-is-idempotent",
          "action": "right",
          "assert": {
            "changed": false,
            "survey_workflow_state": "result",
            "survey_workflow_status": "committed",
            "survey_generation": 2,
            "library_generation": 2,
            "survey_pipeline_status": "committed",
            "survey_batch_trigger": "stop"
          }
        },
        {
          "id": "back-home-from-survey",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 1,
            "selected_id": "survey",
            "runtime_owner": "none",
            "lease_mask": 0,
            "survey_generation": 2,
            "library_generation": 2
          }
        },
        {
          "id": "select-library",
          "action": "down",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 2,
            "selected_id": "library",
            "runtime_owner": "none",
            "lease_mask": 0
          }
        },
        {
          "id": "open-library",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "library",
            "library_view": "list",
            "runtime_owner": "library",
            "lease_mask": 1,
            "library_entries": 1,
            "library_generation": 2,
            "library_simulated": true,
            "library_persistent": false
          },
          "capture": {
            "name": "survey-library",
            "golden": "goldens/esp32-div-v2-n16/survey-library.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "open-library-detail",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "library",
            "library_view": "detail",
            "library_generation": 2
          },
          "capture": {
            "name": "survey-library-detail",
            "golden": "goldens/esp32-div-v2-n16/survey-library-detail.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "prepare-export",
          "action": "right",
          "assert": {
            "changed": true,
            "page": "library",
            "library_view": "export_ready",
            "library_generation": 2,
            "library_persistent": false
          },
          "capture": {
            "name": "survey-library-export",
            "golden": "goldens/esp32-div-v2-n16/survey-library-export.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "verify-export",
          "query": {
            "command": "library.export",
            "schema": "leshy.library.export.v1",
            "kind": "artifact"
          },
          "assert": {
            "status": "valid",
            "generation": 2,
            "integrity": "valid",
            "storage_backend": "bounded_ram",
            "persistent": false,
            "simulated": true,
            "radio_touched": false,
            "session": {
              "schema": "leshy.session.summary.v1",
              "id": "product-wifi-preview",
              "observations": 3,
              "dropped": 0,
              "sources": {
                "wifi": 3
              }
            }
          }
        },
        {
          "id": "back-library-detail",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "library",
            "library_view": "detail",
            "runtime_owner": "library",
            "lease_mask": 1
          }
        },
        {
          "id": "back-library-list",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "library",
            "library_view": "list",
            "runtime_owner": "library",
            "lease_mask": 1
          }
        },
        {
          "id": "back-home-from-library",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 2,
            "selected_id": "library",
            "runtime_owner": "none",
            "lease_mask": 0,
            "survey_generation": 2,
            "library_generation": 2
          }
        }
      ]
    }
  ],
  "final_state_assert": {
    "page": "home",
    "runtime_owner": "none",
    "lease_mask": 0
  },
  "metrics_assert": {
    "heap_free": {
      "$gte": 131072
    },
    "heap_min_free": {
      "$gte": 131072
    },
    "buzzer_inactive": true
  },
  "safe_outputs_assert": {
    "buzzer_pin": 2,
    "buzzer_mode": "output",
    "buzzer_level": "low",
    "buzzer_inactive": true
  }
}
