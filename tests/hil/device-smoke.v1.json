{
  "schema": "leshy.prerelease.suite.v1",
  "id": "device-smoke",
  "revision": 1,
  "maximum_ready_marker_ms": 2000,
  "boot_assert": {
    "target": "clean_1x_measure",
    "profile": "esp32-div-v2-n16",
    "profile_revision": "S1-2026-08-16",
    "flash_bytes": 16777216,
    "psram_found": false,
    "buzzer_safety_configured": true,
    "buzzer_inactive": true,
    "input_detected": true,
    "interactive_ready_us": {
      "$lte": 2000000
    }
  },
  "scenarios": [
    {
      "id": "home-diagnostics-back",
      "steps": [
        {
          "id": "home",
          "assert": {
            "page": "home",
            "selection": 0,
            "selected_id": "diagnostics",
            "selected_enabled": true,
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "home",
            "golden": "goldens/esp32-div-v2-n16/home.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "open-diagnostics",
          "action": "select",
          "assert": {
            "changed": true,
            "page": "diagnostics",
            "selected_id": "diagnostics",
            "runtime_owner": "diagnostics",
            "lease_mask": 1
          },
          "capture": {
            "name": "diagnostics",
            "golden": "goldens/esp32-div-v2-n16/diagnostics.rgb565.zlib",
            "mode": "masked_exact",
            "masks": [
              [0, 145, 240, 55]
            ]
          }
        },
        {
          "id": "back-home",
          "action": "back",
          "assert": {
            "changed": true,
            "page": "home",
            "selection": 0,
            "selected_id": "diagnostics",
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "home-after-back",
            "golden": "goldens/esp32-div-v2-n16/home-after-back.rgb565.zlib",
            "mode": "exact"
          }
        }
      ]
    }
  ],
  "final_state_assert": {
    "page": "home",
    "runtime_owner": "none",
    "lease_mask": 0
  },
  "metrics_assert": {
    "heap_free": {
      "$gte": 131072
    },
    "heap_min_free": {
      "$gte": 131072
    },
    "buzzer_inactive": true
  },
  "safe_outputs_assert": {
    "buzzer_pin": 2,
    "buzzer_mode": "output",
    "buzzer_level": "low",
    "buzzer_inactive": true
  }
}
