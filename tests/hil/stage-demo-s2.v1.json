            "checks": [
              {"id": "quick.build.identity", "status": "pass"},
              {"id": "quick.board.profile", "status": "pass"},
              {"id": "quick.runtime.heap", "status": "pass"},
              {"id": "quick.display.ready", "status": "pass"},
              {"id": "quick.input.frontend", "status": "pass"},
              {"id": "quick.input.queue", "status": "pass"},
              {"id": "quick.output.buzzer", "status": "pass"},
              {"id": "quick.resource.scope", "status": "pass"}
