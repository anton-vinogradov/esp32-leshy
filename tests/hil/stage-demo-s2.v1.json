        {"id": "back-home-after-quick", "action": "back", "assert": {"page": "home", "selection": 4, "selected_id": "self-test", "runtime_owner": "none", "lease_mask": 0}},
        {"id": "home-language-up", "action": "up", "assert": {"page": "home", "selection": 3, "selected_id": "language"}},
        {"id": "home-library-up", "action": "up", "assert": {"page": "home", "selection": 2, "selected_id": "library"}},
        {"id": "home-survey-up", "action": "up", "assert": {"page": "home", "selection": 1, "selected_id": "survey"}},
        {"id": "home-diagnostics-up", "action": "up", "assert": {"page": "home", "selection": 0, "selected_id": "diagnostics"}},
        {
          "id": "open-diagnostics",
          "action": "select",
          "assert": {
            "page": "diagnostics",
            "runtime_owner": "diagnostics",
            "lease_mask": 1
          },
          "capture": {
            "name": "diagnostics",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-diagnostics.rgb565.zlib",
            "mode": "masked_exact",
            "masks": [[0, 145, 240, 55]]
          }
        },
        {
          "id": "back-home-after-diagnostics",
          "action": "back",
          "assert": {
            "page": "home",
            "selection": 0,
            "selected_id": "diagnostics",
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "home-after-diagnostics",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-home-after-diagnostics.rgb565.zlib",
            "mode": "exact"
          }
        },
        {"id": "return-survey", "action": "down", "assert": {"page": "home", "selection": 1}},
        {"id": "return-library", "action": "down", "assert": {"page": "home", "selection": 2}},
        {"id": "return-language", "action": "down", "assert": {"page": "home", "selection": 3}},
        {"id": "return-self-test", "action": "down", "assert": {"page": "home", "selection": 4, "selected_id": "self-test"}},
        {"id": "open-self-test-again", "action": "select", "assert": {"page": "self_test", "self_test_view": "mode_menu", "self_test_mode": "quick"}},
        {"id": "select-full", "action": "down", "assert": {"page": "self_test", "self_test_view": "mode_menu", "self_test_mode": "full_guided"}},
        {
          "id": "full-preflight",
          "action": "select",
          "assert": {"page": "self_test", "self_test_view": "preflight", "self_test_mode": "full_guided"},
          "capture": {
            "name": "full-preflight",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-full-preflight.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "full-dialog-confirm",
          "action": "select",
          "assert": {
            "page": "self_test",
            "self_test_view": "visual_check",
            "self_test_visual_state": "dialog_confirm",
            "self_test_mode": "full_guided",
            "self_test_checks": 8,
            "self_test_passed": 8,
            "self_test_failed": 0,
            "self_test_blocked": 0
          },
          "capture": {
            "name": "full-dialog-confirm",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-full-dialog-confirm.rgb565.zlib",
            "mode": "exact"
          }
        },
        {
          "id": "full-unavailable-reason",
          "action": "select",
          "assert": {
            "page": "self_test",
            "self_test_view": "visual_check",
            "self_test_visual_state": "unavailable",
            "self_test_mode": "full_guided",
            "runtime_owner": "self-test",
            "lease_mask": 1
          },
          "capture": {
            "name": "full-unavailable-reason",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-full-unavailable-reason.rgb565.zlib",
            "mode": "exact"
          }
        },
        {"id": "cancel-full", "action": "back", "assert": {"page": "self_test", "self_test_view": "preflight", "runtime_owner": "self-test", "lease_mask": 1}},
        {"id": "back-full-modes", "action": "back", "assert": {"page": "self_test", "self_test_view": "mode_menu", "runtime_owner": "self-test", "lease_mask": 1}},
        {
          "id": "final-back-home",
          "action": "back",
          "assert": {
            "page": "home",
            "selection": 4,
            "selected_id": "self-test",
            "runtime_owner": "none",
            "lease_mask": 0
          },
          "capture": {
            "name": "final-home",
            "golden": "goldens/esp32-div-v2-n16/stage-s2-0.58-final-home.rgb565.zlib",
            "mode": "exact"
          }
        }
      ]
    }
